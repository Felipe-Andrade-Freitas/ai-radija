trigger:
  branches:
    include:
      - main
      - develop

variables:
  buildConfiguration: 'Release'

stages:
  - stage: Build
    jobs:
      - job: BuildBackend
        pool:
          vmImage: 'ubuntu-latest'
        steps:
          - checkout: self
          - task: UseDotNet@2
            inputs:
              version: '9.x'
            condition: eq('{{Backend}}', 'dotnet')
          - script: echo "Build backend {{Backend}}"
          - script: echo "Run tests with coverage >= {{CoverageBackend}}%"

      - job: BuildFrontend
        condition: ne('{{Frontend}}', 'none')
        pool:
          vmImage: 'ubuntu-latest'
        steps:
          - checkout: self
          - task: NodeTool@0
            inputs:
              versionSpec: '20.x'
          - script: echo "Build frontend {{Frontend}}"

  - stage: Deploy_Dev
    dependsOn: Build
    condition: eq(variables['Build.SourceBranch'], 'refs/heads/develop')
    jobs:
      - deployment: DeployDev
        environment: '{{ProjectName}}-Dev'
        strategy:
          runOnce:
            deploy:
              steps:
                - script: echo "Deploy to {{Hosting}} (dev)"

  - stage: Deploy_Prod
    dependsOn: Build
    condition: eq(variables['Build.SourceBranch'], 'refs/heads/main')
    jobs:
      - deployment: DeployProd
        environment: '{{ProjectName}}-Prod'
        strategy:
          runOnce:
            deploy:
              steps:
                - script: echo "Deploy to {{Hosting}} (prod)"
