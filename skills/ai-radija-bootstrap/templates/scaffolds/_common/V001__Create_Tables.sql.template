CREATE TABLE {{AppPrefix}}_Users
(
    UserId        UNIQUEIDENTIFIER  NOT NULL  DEFAULT NEWID(),
    Email         NVARCHAR(256)     NOT NULL,
    DisplayName   NVARCHAR(200)     NOT NULL,
    PasswordHash  NVARCHAR(512)     NULL,            -- Argon2id or bcrypt only
    CreatedAt     DATETIME2         NOT NULL  DEFAULT GETUTCDATE(),
    CreatedBy     NVARCHAR(100)     NOT NULL  DEFAULT 'system',
    UpdatedAt     DATETIME2         NULL,
    UpdatedBy     NVARCHAR(100)     NULL,
    IsActive      BIT               NOT NULL  DEFAULT 1,
    CONSTRAINT PK_{{AppPrefix}}_Users PRIMARY KEY (UserId),
    CONSTRAINT UQ_{{AppPrefix}}_Users_Email UNIQUE (Email)
);
GO

-- Example stored procedure following naming convention sp_{{AppPrefix}}_{Verb}{Entity}
CREATE OR ALTER PROCEDURE sp_{{AppPrefix}}_GetActiveUsers
AS
BEGIN
    SET NOCOUNT ON;
    SELECT UserId, Email, DisplayName, CreatedAt, UpdatedAt
    FROM {{AppPrefix}}_Users
    WHERE IsActive = 1
    ORDER BY CreatedAt DESC;
END
